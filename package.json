{
  "name": "@matt.kantor/please",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "please"
  ],
  "bin": {
    "please": "please"
  },
  "workspaces": [
    "editors/vscode"
  ],
  "//": "The ugly `bash -c` contortions in the scripts below are to work around <https://github.com/npm/cli/issues/8583>.",
  "scripts": {
    "0": "bash -c 'node ./dist/language/cli/0.js \"$@\"; echo' bash",
    "1": "bash -c 'node ./dist/language/cli/1.js \"$@\"; echo' bash",
    "2": "bash -c 'node ./dist/language/cli/2.js \"$@\"; echo' bash",
    "build": "tsc --build tsconfig.app.json --force",
    "build:all": "tsc --build --force",
    "build:grammar": "npm run build && node ./dist/language/highlighting/write-tmlanguage.js editors/vscode/syntaxes/please.tmLanguage.json",
    "build:tests": "tsc --project tsconfig.app.json && rm -rf dist-test && cp -R dist dist-test && rm -f tsconfig.test.tsbuildinfo && tsc --build tsconfig.test.json",
    "clean": "rm -rf dist* *.tsbuildinfo editors/*/dist editors/*/*.tsbuildinfo",
    "lint": "eslint .; prettier --check .",
    "lint:fix": "eslint --fix .; prettier --write .",
    "test": "npm run build:tests && node --test --no-experimental-strip-types",
    "test-update-snapshots": "npm run build:tests && node --test --no-experimental-strip-types --test-update-snapshots",
    "watch": "tsc --build --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "@matt.kantor/either": "^1.4.0",
    "@matt.kantor/option": "^1.2.0",
    "@matt.kantor/parsing": "^3.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
